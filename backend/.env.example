# Copiez ce fichier en ".env" (sans ".example") avant de lancer le serveur.

# Clé secrète Flask, sert à sécuriser les sessions (cookies de connexion).
# Mettez n'importe quelle longue chaîne aléatoire.
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire

# Mot de passe unique pour accéder à l'application (pas de comptes multiples).
APP_PASSWORD=motdepasse123

# Base de données :
# - Pour le prototype de demain, on utilise SQLite (fichier local, zéro configuration).
# - Le jour où la base passera sur Neon, remplacez cette ligne par l'URL Neon
#   (postgresql://...) sans toucher au reste du code.
DATABASE_URL=sqlite:///boutique.db

# Adresse du frontend React, pour autoriser les requêtes (CORS)
FRONTEND_URL=http://localhost:5173
